<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="32" height="32">
  <rect width="32" height="32" fill="#0A1628"/>
  <!-- Left leg -->
  <line x1="16" y1="5" x2="6.5" y2="27" stroke="white" stroke-width="2.8" stroke-linecap="butt"/>
  <!-- Right leg -->
  <line x1="16" y1="5" x2="25.5" y2="27" stroke="white" stroke-width="2.8" stroke-linecap="butt"/>
  <!-- Crossbar -->
  <line x1="11" y1="18.5" x2="21" y2="18.5" stroke="white" stroke-width="2.2" stroke-linecap="round"/>
  <!-- Left foot serif -->
  <line x1="3.5" y1="27" x2="9.5" y2="27" stroke="white" stroke-width="2.2" stroke-linecap="round"/>
  <!-- Right foot serif -->
  <line x1="22.5" y1="27" x2="28.5" y2="27" stroke="white" stroke-width="2.2" stroke-linecap="round"/>
</svg>
